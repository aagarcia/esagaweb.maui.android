<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Esagaweb.Maui.Android.Controls.Dialog.M3Dialog">
    <!-- IMPORTANT: root content goes in explicit ContentView.Content.
         Without this wrapper, the XAML generator assigns it to the [ContentProperty]
         (DialogContent), whose setter nests it inside CustomContent creating
         a cycle in the visual tree (ANR from infinite layout). See M3TopAppBar. -->
    <ContentView.Content>
        <Border x:Name="Card"
            StrokeThickness="0"
            Padding="24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="280">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="28" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="16">
            <Label x:Name="TitleLabel"
                   FontFamily="NunitoSemiBold"
                   FontSize="22"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="MessageLabel"
                   FontFamily="NunitoRegular"
                   FontSize="14" />
            <ContentView x:Name="CustomContent" IsVisible="False" />
            <HorizontalStackLayout x:Name="ActionsRow"
                                   Spacing="8"
                                   HorizontalOptions="End">
                <Button x:Name="CancelButton"
                        FontFamily="NunitoSemiBold"
                        BackgroundColor="Transparent"
                        IsVisible="False" />
                <Button x:Name="ConfirmButton"
                        FontFamily="NunitoSemiBold"
                        IsVisible="False" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
    </ContentView.Content>
</ContentView>
