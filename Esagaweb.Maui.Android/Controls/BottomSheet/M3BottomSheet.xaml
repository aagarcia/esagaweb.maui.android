<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Esagaweb.Maui.Android.Controls.BottomSheet.M3BottomSheet">
    <!-- IMPORTANTE: el contenido raíz va en ContentView.Content explícito.
         Sin este wrapper, el generador XAML lo asigna al [ContentProperty]
         (SheetBody), cuyo setter lo mete dentro de SheetContent creando un
         ciclo en el árbol visual (ANR por layout infinito). Ver M3TopAppBar. -->
    <ContentView.Content>
        <Border x:Name="Sheet"
                StrokeThickness="0"
                Padding="16,8,16,16"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <BoxView x:Name="Handle"
                         HeightRequest="4"
                         WidthRequest="32"
                         CornerRadius="2"
                         HorizontalOptions="Center" />
                <Label x:Name="TitleLabel"
                       FontFamily="NunitoSemiBold"
                       FontSize="16"
                       IsVisible="False" />
                <ContentView x:Name="SheetContent" />
            </VerticalStackLayout>
        </Border>
    </ContentView.Content>
</ContentView>
