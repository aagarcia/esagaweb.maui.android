<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Esagaweb.Maui.Android.Controls.BottomSheet.M3BottomSheet">
    <!-- IMPORTANT: root content goes in explicit ContentView.Content.
         Without this wrapper, the XAML generator assigns it to the [ContentProperty]
         (SheetBody), whose setter nests it inside SheetContent creating a
         cycle in the visual tree (ANR from infinite layout). See M3TopAppBar. -->
    <ContentView.Content>
        <Border x:Name="Sheet"
                StrokeThickness="0"
                Padding="16,8,16,16"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <BoxView x:Name="Handle"
                         BackgroundColor="Transparent"
                         HeightRequest="4"
                         WidthRequest="32"
                         CornerRadius="2"
                         HorizontalOptions="Center" />
                <Label x:Name="TitleLabel"
                       FontFamily="NunitoSemiBold"
                       FontSize="16"
                       IsVisible="False" />
                <ContentView x:Name="SheetContent" />
            </VerticalStackLayout>
        </Border>
    </ContentView.Content>
</ContentView>
