<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:iconbtn="clr-namespace:Esagaweb.Maui.Android.Controls.IconButtons"
             x:Class="Esagaweb.Maui.Android.Controls.TopAppBar.M3TopAppBar">
    <ContentView.Content>
        <VerticalStackLayout x:Name="Root" Spacing="0">
            <Grid x:Name="Toolbar"
                  HeightRequest="64"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="4"
                  Padding="4,0"
                  VerticalOptions="Start">
                <iconbtn:M3IconButton x:Name="NavButton"
                                      Variant="Standard"
                                      VerticalOptions="Center" />
                <Label x:Name="SmallTitle"
                       Grid.Column="1"
                       FontFamily="NunitoSemiBold"
                       FontSize="22"
                       VerticalOptions="Center" />
                <HorizontalStackLayout x:Name="ActionsHost"
                                       Grid.Column="2"
                                       Spacing="0"
                                       VerticalOptions="Center" />
            </Grid>
            <Label x:Name="BigTitle"
                   FontFamily="NunitoSemiBold"
                   FontSize="28"
                   Margin="16,8,16,16"
                   IsVisible="False" />
        </VerticalStackLayout>
    </ContentView.Content>
</ContentView>
