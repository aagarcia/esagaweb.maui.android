<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Esagaweb.Maui.Android.Controls.IconButtons.M3IconButton">
    <Border x:Name="RootBorder"
            HeightRequest="48"
            WidthRequest="48"
            StrokeThickness="1"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24" />
        </Border.StrokeShape>
        <!-- Dual: Glyph (ALWAYS MaterialSymbols in its own Label) or fallback Image. -->
        <Grid>
            <Label x:Name="GlyphLabel"
                   FontFamily="MaterialSymbols"
                   FontSize="24"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
            <Image x:Name="ButtonImage"
                   HeightRequest="24"
                   WidthRequest="24"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   IsVisible="False" />
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
            <PointerGestureRecognizer PointerPressed="OnPointerPressed"
                                       PointerReleased="OnPointerReleased" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
