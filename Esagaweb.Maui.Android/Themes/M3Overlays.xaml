<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Esagaweb.Maui.Android.Themes.M3Overlays">

    <!-- Dimensiones de overlays (carpeta Themes). Colores en M3Colors.xaml. -->

    <!-- M3Dialog: ancho máx 280dp M3, radio 28dp, padding 24dp -->
    <x:Double x:Key="M3DialogMaxWidth">280</x:Double>
    <x:Double x:Key="M3DialogCornerRadius">28</x:Double>
    <Thickness x:Key="M3DialogPadding">24</Thickness>

    <!-- M3BottomSheet: radio superior 28dp, padding 16dp -->
    <x:Double x:Key="M3BottomSheetCornerRadius">28</x:Double>
    <Thickness x:Key="M3BottomSheetPadding">16,8,16,16</Thickness>
    <x:Double x:Key="M3BottomSheetHandleWidth">32</x:Double>
    <x:Double x:Key="M3BottomSheetHandleHeight">4</x:Double>

    <!-- M3Snackbar: altura mín 48dp, radio 4dp, margen 8dp -->
    <x:Double x:Key="M3SnackbarMinHeight">48</x:Double>
    <x:Double x:Key="M3SnackbarCornerRadius">4</x:Double>
    <Thickness x:Key="M3SnackbarMargin">8</Thickness>
    <x:Double x:Key="M3SnackbarDurationSeconds">4</x:Double>

    <!-- M3Chip: altura 32dp, radio 8dp -->
    <x:Double x:Key="M3ChipHeight">32</x:Double>
    <x:Double x:Key="M3ChipCornerRadius">8</x:Double>

    <!-- M3Badge: tamaño 16dp, radio 8dp -->
    <x:Double x:Key="M3BadgeSize">16</x:Double>
    <x:Double x:Key="M3BadgeCornerRadius">8</x:Double>
</ResourceDictionary>
