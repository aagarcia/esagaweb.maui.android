<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Esagaweb.Maui.Android.Themes.M3Colors">

    <!-- M3 baseline (seed #6750A4). Android-only. Light + Dark via AppThemeBinding. -->

    <!-- Light -->
    <Color x:Key="M3Primary">#6750A4</Color>
    <Color x:Key="M3OnPrimary">#FFFFFF</Color>
    <Color x:Key="M3PrimaryContainer">#EADDFF</Color>
    <Color x:Key="M3OnPrimaryContainer">#21005D</Color>
    <Color x:Key="M3Secondary">#625B71</Color>
    <Color x:Key="M3OnSecondary">#FFFFFF</Color>
    <Color x:Key="M3SecondaryContainer">#E8DEF8</Color>
    <Color x:Key="M3OnSecondaryContainer">#1D192B</Color>
    <Color x:Key="M3Tertiary">#7D5260</Color>
    <Color x:Key="M3OnTertiary">#FFFFFF</Color>
    <Color x:Key="M3TertiaryContainer">#FFD8E4</Color>
    <Color x:Key="M3OnTertiaryContainer">#31111D</Color>
    <Color x:Key="M3Surface">#FEF7FF</Color>
    <Color x:Key="M3OnSurface">#1D1B20</Color>
    <Color x:Key="M3SurfaceVariant">#E7E0EC</Color>
    <Color x:Key="M3OnSurfaceVariant">#49454F</Color>
    <Color x:Key="M3Outline">#79747E</Color>
    <Color x:Key="M3Error">#B3261E</Color>
    <Color x:Key="M3OnError">#FFFFFF</Color>

    <!-- Dark -->
    <Color x:Key="M3DarkPrimary">#D0BCFF</Color>
    <Color x:Key="M3DarkOnPrimary">#381E72</Color>
    <Color x:Key="M3DarkPrimaryContainer">#4F378B</Color>
    <Color x:Key="M3DarkOnPrimaryContainer">#EADDFF</Color>
    <Color x:Key="M3DarkSecondaryContainer">#4A4458</Color>
    <Color x:Key="M3DarkOnSecondaryContainer">#E8DEF8</Color>
    <Color x:Key="M3DarkTertiaryContainer">#633B48</Color>
    <Color x:Key="M3DarkOnTertiaryContainer">#FFD8E4</Color>
    <Color x:Key="M3DarkSurface">#141218</Color>
    <Color x:Key="M3DarkOnSurface">#E6E0E9</Color>
    <Color x:Key="M3DarkSurfaceVariant">#49454F</Color>
    <Color x:Key="M3DarkOutline">#938F99</Color>
    <Color x:Key="M3DarkError">#F2B8B5</Color>
    <Color x:Key="M3DarkOnError">#601410</Color>

    <!-- Adaptive: resolved at usage with {AppThemeBinding Light={StaticResource M3Primary}, Dark={StaticResource M3DarkPrimary}} -->

    <!-- Shapes M3 (dp) -->
    <x:Double x:Key="M3ShapeExtraSmall">4</x:Double>
    <x:Double x:Key="M3ShapeSmall">8</x:Double>
    <x:Double x:Key="M3ShapeMedium">12</x:Double>
    <x:Double x:Key="M3ShapeLarge">16</x:Double>
    <x:Double x:Key="M3ShapeExtraLarge">28</x:Double>

    <!-- Android elevation (dp) -->
    <x:Double x:Key="M3Elevation1">1</x:Double>
    <x:Double x:Key="M3Elevation2">3</x:Double>
    <x:Double x:Key="M3Elevation3">6</x:Double>
</ResourceDictionary>
