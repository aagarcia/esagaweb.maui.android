<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Esagaweb.Maui.Android.Themes.M3Buttons">

    <!-- Shared button dimensions (Themes folder). Colors in M3Colors.xaml. -->

    <!-- M3Button -->
    <x:Double x:Key="M3ButtonHeightCompact">40</x:Double>
    <x:Double x:Key="M3ButtonHeightExpanded">48</x:Double>
    <x:Double x:Key="M3ButtonCornerRadius">20</x:Double>
    <Thickness x:Key="M3ButtonPadding">24,0</Thickness>
    <x:Double x:Key="M3ButtonIconSize">18</x:Double>

    <!-- M3Fab -->
    <x:Double x:Key="M3FabSmall">48</x:Double>
    <x:Double x:Key="M3FabRegular">56</x:Double>
    <x:Double x:Key="M3FabLarge">96</x:Double>

    <!-- M3IconButton (touch target 48, icon 24) -->
    <x:Double x:Key="M3IconButtonSize">48</x:Double>
    <x:Double x:Key="M3IconSize">24</x:Double>
</ResourceDictionary>
