<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Esagaweb.Maui.Android.Themes.M3Surfaces">

    <!-- Card + app bar + navigation dimensions (Themes folder). Colors in M3Colors.xaml. -->

    <!-- M3Card (M3 medium shape, padding, Flutter default margin = 4) -->
    <x:Double x:Key="M3CardCornerRadius">12</x:Double>
    <Thickness x:Key="M3CardPadding">16</Thickness>

    <!-- M3TopAppBar -->
    <x:Double x:Key="M3AppBarSmallHeight">64</x:Double>
    <x:Double x:Key="M3AppBarMediumHeight">112</x:Double>
    <x:Double x:Key="M3AppBarLargeHeight">152</x:Double>

    <!-- M3NavigationBar / Rail -->
    <x:Double x:Key="M3NavBarHeight">80</x:Double>
    <x:Double x:Key="M3NavRailWidth">80</x:Double>
    <x:Double x:Key="M3NavIndicatorWidth">64</x:Double>
    <x:Double x:Key="M3NavIndicatorHeight">32</x:Double>
</ResourceDictionary>
