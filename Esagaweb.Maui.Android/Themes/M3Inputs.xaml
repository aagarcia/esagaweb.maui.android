<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Esagaweb.Maui.Android.Themes.M3Inputs">

    <!-- Input dimensions (Themes folder). Colors in M3Colors.xaml. -->

    <!-- M3TextField: height 56dp M3, radius 4dp, icons 24dp -->
    <x:Double x:Key="M3TextFieldHeight">56</x:Double>
    <x:Double x:Key="M3TextFieldCornerRadius">4</x:Double>
    <x:Double x:Key="M3TextFieldIconSize">24</x:Double>
    <x:Double x:Key="M3TextFieldLabelSize">12</x:Double>
    <x:Double x:Key="M3TextFieldInputSize">16</x:Double>
    <x:Double x:Key="M3TextFieldSupportSize">12</x:Double>
    <Thickness x:Key="M3TextFieldPadding">12,0</Thickness>
    <x:Double x:Key="M3TextFieldIndicatorActive">2</x:Double>
    <x:Double x:Key="M3TextFieldIndicatorInactive">1</x:Double>

    <!-- Selection rows: touch height 48-56dp -->
    <x:Double x:Key="M3SelectionRowHeight">48</x:Double>
    <x:Double x:Key="M3SelectionLabelSize">16</x:Double>
</ResourceDictionary>
