<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<!-- Android-only by project decision. No iOS/Windows/macOS. -->
		<!-- MAUI pin: latest baked stable (10.0.101).
		     The MAUI workload's $(MauiVersion) is 10.0.20; this override only affects this project. -->
		<MauiVersion>10.0.101</MauiVersion>

		<OutputType>Exe</OutputType>
		<RootNamespace>Esagaweb.Maui.Android.Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Esagaweb Sample</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.esagaweb.sample</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts: none of its own; the M3 fonts arrive from the library
		     (MauiFont items do not flow transitively via ProjectReference,
		      so they are linked here explicitly; aliases are registered
		      by builder.UseEsagaweb()). -->
		<MauiFont Include="..\Esagaweb.Maui.Android\Resources\Fonts\*.ttf" />

	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Sample dogfoods the library source directly (no local NuGet feed). -->
		<ProjectReference Include="..\Esagaweb.Maui.Android\Esagaweb.Maui.Android.csproj" />
	</ItemGroup>

</Project>
